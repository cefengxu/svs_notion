# Notion API 配置示例
# 复制此文件为 .env，并填入你的真实值

# Notion Integration API Key（必填）
NOTION_API_KEY=ntn_your_api_key_here

# 用于创建页面的 Database ID（必填）
NOTION_DATABASE_ID=your_database_id_here

# 用于查询的 Data Source ID（必填，与 database_id 不同）
# 可以通过 /api/notion/search 接口查询得到
NOTION_DATA_SOURCE_ID=your_data_source_id_here

# 服务监听端口（可选，默认 8000）
PORT=8000
